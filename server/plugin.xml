<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension
         id="importers"
         point="org.eclipse.jdt.ls.core.importers">
      <importer
            id="bazelAqueryProjectImporter"
            order="150"
            class="io.github.sorteam.bazel.jdtls.BazelProjectImporter"/>
   </extension>
   <extension
         id="buildSupport"
         point="org.eclipse.jdt.ls.core.buildSupport">
      <buildSupport
            id="bazelBuildSupport"
            order="150"
            class="io.github.sorteam.bazel.jdtls.BazelBuildSupport"/>
   </extension>
   <extension
         point="org.eclipse.jdt.core.classpathContainerInitializer">
      <classpathContainerInitializer
            id="io.github.sorteam.bazel.jdtls.BAZEL_CONTAINER"
            class="io.github.sorteam.bazel.jdtls.BazelClasspathContainerInitializer"/>
   </extension>
   <extension
         point="org.eclipse.jdt.ls.core.delegateCommandHandler">
      <delegateCommandHandler class="io.github.sorteam.bazel.jdtls.BazelCommandHandler">
         <command id="jbazel.refreshClasspath"/>
         <command id="jbazel.showImportReport"/>
         <command id="jbazel.buildClasspath"/>
         <command id="jbazel.fetchLibrarySources"/>
         <command id="jbazel.doctor"/>
         <command id="jbazel.importFile"/>
         <command id="jbazel.status"/>
         <command id="jbazel.buildFilesChanged"/>
      </delegateCommandHandler>
   </extension>
</plugin>
